{
  "name": "dsh-api-client",
  "version": "0.0.1-spike.0",
  "description": "Agent-native API Client for DeepSeek Harness — M0 compatibility spike probe plugin (host half + client half).",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "gen:manifest-contract": "tsx scripts/gen-manifest-contract.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@dsh-api-client/core": "workspace:*",
    "@dsh-api-client/postman-adapter": "workspace:*",
    "@dsh-api-client/shared": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  }
}
